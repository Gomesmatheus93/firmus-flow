# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do .env.

# ---------------------------------------------------------------- Geral
NODE_ENV=development

# ---------------------------------------------------------------- API
API_PORT=3333
API_BASE_URL=http://localhost:3333
WEB_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------- Supabase
# Painel do Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de administrador: só no servidor, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=brand-assets
# Painel do Supabase > Project Settings > Database > Connection string
DATABASE_URL=

# ---------------------------------------------------------------- Anthropic
ANTHROPIC_API_KEY=
# Modelo padrão dos agentes.
ANTHROPIC_MODEL=claude-opus-5-5
# Modelo barato, para tarefas simples e de alto volume.
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Ao trocar de modelo, cadastre o preço dele em
# packages/agents/src/runtime/pricing.ts — senão o agente para na hora de
# calcular o custo, de propósito.

# ---------------------------------------------------------------- Criptografia
# Chave da plataforma que cifra os segredos de cliente guardados no banco
# (token do Instagram e, depois, do WhatsApp de cada empresa).
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave torna ilegivel tudo que ja foi cifrado com a anterior.
FIRMUS_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Redis (fila)
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- Meta / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
# Token que você inventa e repete no painel da Meta ao cadastrar o webhook.
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------- Frontend (Vite)
# Só variáveis com prefixo VITE_ chegam ao navegador. Nunca coloque segredo aqui.
VITE_API_BASE_URL=http://localhost:3333
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
